<h1 class="text-2xl font-bold mb-2">Ingestion Summary</h1>
<div class="text-sm text-gray-600 mb-4">Batch #<%= @batch.id %> · Source: <%= @batch.source&.name %></div>
<div class="grid md:grid-cols-3 gap-4">
  <div class="bg-white border rounded p-4">
    <div class="text-gray-500 text-xs">Status</div>
    <div class="text-lg font-semibold"><%= @batch.status %></div>
  </div>
  <div class="bg-white border rounded p-4">
    <div class="text-gray-500 text-xs">Counts</div>
    <div class="text-lg font-semibold">
      <%= @batch.processed_count || 0 %> ok ·
      <%= @batch.duplicate_count || 0 %> dup ·
      <%= (@batch.total_count || 0) - (@batch.processed_count || 0) %> err
    </div>
  </div>
  <div class="bg-white border rounded p-4">
    <div class="text-gray-500 text-xs">Timing</div>
    <div class="text-lg font-semibold"><%= @batch.started_at&.strftime('%F %R') %> → <%= @batch.finished_at&.strftime('%F %R') %></div>
  </div>
</div>
<div class="mt-6 text-sm">
  <a class="link-brand" href="<%= ingestions_path %>">Back to batches</a>
</div>

